# Root folder containing batch folders (batch_0_day1, batch_1_day2, batch_2_day3) and reference/
DATA_ROOT=C:/path/to/MediaSync_Source_Data

# Secret salt used for deterministic SHA-256 tokenization of patient_id
MEDISYNC_SALT=change_me_to_a_secure_random_string

# Warehouse and landing root directories
WAREHOUSE_PATH=./warehouse
LANDING_PATH=./landing

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
